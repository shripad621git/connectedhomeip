From e339708e746392adfc542516e363d65c5e18e376 Mon Sep 17 00:00:00 2001
From: shripad621git <shripad62001@gmail.com>
Date: Fri, 13 Nov 2026 13:28:55 +0530
Subject: [PATCH 6/6] drivers: gpio: esp32: use the gpio base for port 1
 registers

The driver read and wrote the input and output registers of the second
port through the devicetree address of gpio1, which is the GPIO base
plus 0x800. in1, out1, out1_w1ts and out1_w1tc are fields of the one
GPIO register block at the gpio0 address.

On the ESP32-S31 nothing is mapped at base + 0x800: GPIO32 to GPIO61
always read 0 and port writes had no effect, so a bit-banged I2C bus on
GPIO50/51 read all zeros and the amplifier enable on GPIO57 could not
be switched. Use the GPIO base for both ports.
---
 drivers/gpio/gpio_esp32.c | 20 ++++++++++----------
 1 file changed, 10 insertions(+), 10 deletions(-)

diff --git a/drivers/gpio/gpio_esp32.c b/drivers/gpio/gpio_esp32.c
index 498850ec59f..ef77eb16d34 100644
--- a/drivers/gpio/gpio_esp32.c
+++ b/drivers/gpio/gpio_esp32.c
@@ -345,10 +345,10 @@ static int gpio_esp32_port_get_raw(const struct device *port, uint32_t *value)
 	const struct gpio_esp32_config *const cfg = port->config;
 
 	if (cfg->gpio_port == 0) {
-		*value = cfg->gpio_dev->in;
+		*value = cfg->gpio_base->in;
 #if DT_NODE_HAS_STATUS_OKAY(DT_NODELABEL(gpio1))
 	} else {
-		*value = cfg->gpio_dev->in1.val;
+		*value = cfg->gpio_base->in1.val;
 #endif
 	}
 
@@ -362,10 +362,10 @@ static int gpio_esp32_port_set_masked_raw(const struct device *port, uint32_t ma
 	uint32_t key = irq_lock();
 
 	if (cfg->gpio_port == 0) {
-		cfg->gpio_dev->out = (cfg->gpio_dev->out & ~mask) | (mask & value);
+		cfg->gpio_base->out = (cfg->gpio_base->out & ~mask) | (mask & value);
 #if DT_NODE_HAS_STATUS_OKAY(DT_NODELABEL(gpio1))
 	} else {
-		cfg->gpio_dev->out1.val = (cfg->gpio_dev->out1.val & ~mask) | (mask & value);
+		cfg->gpio_base->out1.val = (cfg->gpio_base->out1.val & ~mask) | (mask & value);
 #endif
 	}
 
@@ -379,10 +379,10 @@ static int gpio_esp32_port_set_bits_raw(const struct device *port, uint32_t pins
 	const struct gpio_esp32_config *const cfg = port->config;
 
 	if (cfg->gpio_port == 0) {
-		cfg->gpio_dev->out_w1ts = pins;
+		cfg->gpio_base->out_w1ts = pins;
 #if DT_NODE_HAS_STATUS_OKAY(DT_NODELABEL(gpio1))
 	} else {
-		cfg->gpio_dev->out1_w1ts.val = pins;
+		cfg->gpio_base->out1_w1ts.val = pins;
 #endif
 	}
 
@@ -394,10 +394,10 @@ static int gpio_esp32_port_clear_bits_raw(const struct device *port, uint32_t pi
 	const struct gpio_esp32_config *const cfg = port->config;
 
 	if (cfg->gpio_port == 0) {
-		cfg->gpio_dev->out_w1tc = pins;
+		cfg->gpio_base->out_w1tc = pins;
 #if DT_NODE_HAS_STATUS_OKAY(DT_NODELABEL(gpio1))
 	} else {
-		cfg->gpio_dev->out1_w1tc.val = pins;
+		cfg->gpio_base->out1_w1tc.val = pins;
 #endif
 	}
 
@@ -410,10 +410,10 @@ static int gpio_esp32_port_toggle_bits(const struct device *port, uint32_t pins)
 	uint32_t key = irq_lock();
 
 	if (cfg->gpio_port == 0) {
-		cfg->gpio_dev->out ^= pins;
+		cfg->gpio_base->out ^= pins;
 #if DT_NODE_HAS_STATUS_OKAY(DT_NODELABEL(gpio1))
 	} else {
-		cfg->gpio_dev->out1.val ^= pins;
+		cfg->gpio_base->out1.val ^= pins;
 #endif
 	}
 
