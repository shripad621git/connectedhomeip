+# Copyright (c) 2026 Espressif Systems (Shanghai) Co., Ltd.
+# SPDX-License-Identifier: Apache-2.0
+
+description: Everest ES8311 mono audio codec
+
+compatible: "everest,es8311"
+
+include: [i2c-device.yaml]
+
+properties:
+  reg:
+    required: true
+
+  amplifier-enable-gpios:
+    type: phandle-array
+    description: |
+      Enable pin of an external power amplifier fed by the codec output.
+      The driver asserts it while output is started.
