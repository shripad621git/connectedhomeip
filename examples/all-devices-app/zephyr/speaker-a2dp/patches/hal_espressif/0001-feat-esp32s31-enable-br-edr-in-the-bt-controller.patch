+      esp_blobs_link(bredr_app ble_app btdm_common btbb)
+    else()
+      esp_blobs_link(ble_app btdm_common btbb)
+    endif()
 
   endif()
 
diff --git a/zephyr/esp32s31/src/bt/bredr_mempool.c b/zephyr/esp32s31/src/bt/bredr_mempool.c
new file mode 100644
index 000000000..9e789d3f2
--- /dev/null
+++ b/zephyr/esp32s31/src/bt/bredr_mempool.c
@@ -0,0 +1,44 @@
+/*
+ * SPDX-FileCopyrightText: 2026 Espressif Systems (Shanghai) CO LTD
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+/* The BR/EDR controller port allocates link buffers through the TLSF API of
+ * the ESP-IDF heap component, which this HAL does not build. These functions
+ * provide the same three calls on top of a Zephyr sys_heap placed at the start
+ * of the pool. The controller serializes its own calls, as it does for TLSF.
+ */
+
+#include <stddef.h>
+#include <stdint.h>
+
+#include <zephyr/kernel.h>
+#include <zephyr/sys/sys_heap.h>
+#include <zephyr/sys/util.h>
+
+void *tlsf_create_with_pool(void *mem, size_t pool_bytes, size_t max_bytes)
+{
+	struct sys_heap *heap = mem;
+	size_t header = ROUND_UP(sizeof(*heap), sizeof(uint64_t));
+
+	ARG_UNUSED(max_bytes);
+
+	if (mem == NULL || pool_bytes <= header) {
+		return NULL;
+	}
+
+	sys_heap_init(heap, (uint8_t *)mem + header, pool_bytes - header);
+
+	return heap;
+}
+
+void *tlsf_malloc(void *tlsf, size_t size)
+{
+	return sys_heap_alloc(tlsf, size);
+}
+
+void tlsf_free(void *tlsf, void *ptr)
+{
+	sys_heap_free(tlsf, ptr);
+}
