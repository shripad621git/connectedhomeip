index 063e7bd92..02bd3e2b1 100644
--- a/components/bt/controller/esp32s31/esp_bt_cfg.h
+++ b/components/bt/controller/esp32s31/esp_bt_cfg.h
@@ -20,9 +20,39 @@ extern "C" {
 #define CONFIG_BT_CTRL_HCI_INTERFACE_USE_RAM 1
 #define CONFIG_BT_CTRL_HCI_CMD_NUM 5
 
-/* Controller mode: BLE only */
+/* Controller mode: dual mode when the host enables BR/EDR, BLE only otherwise */
 #define CONFIG_BT_CTRL_BLE_ENABLE 1
+#if defined(CONFIG_BT_CLASSIC)
+#define CONFIG_BT_CTRL_BREDR_ENABLE 1
+#define CONFIG_BTDM_CTRL_MODE_BTDM 1
+
+/* BR/EDR links and buffers */
+#define CONFIG_BT_CTRL_BR_EDR_MAX_ACL_CONN CONFIG_ESP32_BT_CTLR_BR_EDR_MAX_ACL_CONN
+#define CONFIG_BT_CTRL_BR_EDR_MAX_SYNC_CONN CONFIG_ESP32_BT_CTLR_BR_EDR_MAX_SYNC_CONN
+#define CONFIG_BT_CTRL_BR_EDR_ACLU_TX_BUF_NB 4
+#define CONFIG_BT_CTRL_BR_EDR_DYNAMIC_ACLU_TX_BUF_NB 0
+#define CONFIG_BT_CTRL_BR_EDR_ACLU_RX_BUF_NB 6
+#if CONFIG_ESP32_BT_CTLR_BR_EDR_MAX_SYNC_CONN > 0
+#define CONFIG_BT_CTRL_BR_EDR_SCO_DATA_PATH_HCI 1
+#define CONFIG_BT_CTRL_BR_EDR_ESCO_EV3_2_SUPP 1
+#define CONFIG_BT_CTRL_BR_EDR_SYNC_TX_BUF_NB (2 + 2 * CONFIG_ESP32_BT_CTLR_BR_EDR_MAX_SYNC_CONN)
+#define CONFIG_BT_CTRL_BR_EDR_SYNC_RX_BUF_NB (4 * CONFIG_ESP32_BT_CTLR_BR_EDR_MAX_SYNC_CONN)
+#endif
+
+/* BR/EDR TX power in dBm */
+#define CONFIG_BT_CTRL_BR_EDR_TX_PWR_ACL_MIN (-13)
+#define CONFIG_BT_CTRL_BR_EDR_TX_PWR_ACL_MAX 4
+#define CONFIG_BT_CTRL_BR_EDR_TX_PWR_PAGE 4
+#define CONFIG_BT_CTRL_BR_EDR_TX_PWR_PSCAN 4
+#define CONFIG_BT_CTRL_BR_EDR_TX_PWR_ISCAN 4
+
+#define CONFIG_BT_CTRL_BR_EDR_LEGACY_AUTH_VENDOR_EVT 1
+
+/* BR/EDR secure simple pairing uses PSA for ECDH, SHA-256 and HMAC */
+#define CONFIG_BT_SMP_CRYPTO_STACK_MBEDTLS 1
+#else
 #define CONFIG_BTDM_CTRL_MODE_BLE_ONLY 1
+#endif
 
 /* Low-power clock source */
 #if defined(CONFIG_ESP32_BT_LE_LP_CLK_SRC_MAIN_XTAL)
