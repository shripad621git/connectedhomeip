#include <zephyr/dt-bindings/gpio/gpio.h>

/ {
	aliases {
		led0 = &light_led;
		i2s-codec-tx = &i2s0;
	};

	leds {
		compatible = "gpio-leds";

		/* External LED; the on-board LED is a WS2812 on GPIO60. */
		light_led: led_0 {
			gpios = <&gpio0 2 GPIO_ACTIVE_HIGH>;
			label = "Matter light";
		};
	};
};

&i2c0 {
	audio_codec: audio-codec@18 {
		compatible = "everest,es8311";
		reg = <0x18>;
	};
};

/* NS4150B speaker amplifier enable on GPIO57 */
&gpio1 {
	speaker-amp-en-hog {
		gpio-hog;
		gpios = <25 GPIO_ACTIVE_HIGH>;
		output-high;
	};
};

/* I2S output to the on-board ES8311 codec; the I2S driver needs the DMA controller */
&i2s0 {
	status = "okay";
};

&dma {
	status = "okay";
};
