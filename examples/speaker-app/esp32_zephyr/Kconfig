mainmenu "Matter Speaker (ESP32 Zephyr)"

config SPEAKER_AUDIO_UDP_TAP
	bool "Send the decoded speaker audio to a host over UDP"
	depends on NET_SOCKETS && NET_IPV4 && NET_UDP
	help
	  Send the decoded audio to a host in UDP datagrams, so that the
	  received audio can be checked without the audio output of the board.
	  A datagram is the 32-bit little-endian index of its first sample,
	  the 32-bit little-endian sample rate and the mono 16-bit
	  little-endian samples.

config SPEAKER_AUDIO_UDP_TAP_HOST
	string "IPv4 address of the host that receives the audio"
	depends on SPEAKER_AUDIO_UDP_TAP
	default "255.255.255.255"

config SPEAKER_AUDIO_UDP_TAP_PORT
	int "UDP port of the host that receives the audio"
	depends on SPEAKER_AUDIO_UDP_TAP
	default 5005

source "Kconfig.zephyr"
