# Matter build defaults for the ESP32-C6 Zephyr sample.
#
# This is a LOCAL copy of the generic config/zephyr/chip-module/Kconfig.defaults,
# deliberately WITHOUT its `rsource "../../nxp/chip-module/Kconfig.defaults"`.
# That NXP file declares classic mbedTLS 3.x Kconfig symbols (MBEDTLS_ECP_C,
# MBEDTLS_HKDF_C, ...) that DO NOT EXIST in this workspace's mbedTLS 4.1 module.
# Even guarded by `if SOC_FAMILY_NXP_RW`, Kconfig still parses them and emits
# "defined without a type" warnings, and Zephyr aborts on any Kconfig warning.
# Keeping our own defaults file avoids that chain entirely.

if CHIP

# Avoid blocking IRQs on synchronous printk (timing-sensitive radio stack).
config PRINTK_SYNC
	bool
	default n

config ASSERT
	bool
	default y

# The ESP32-C6 has no PMP hardware stack guard in Zephyr v4.4.1; leave HW stack
# protection off (software canaries are enabled in prj.conf instead).
config HW_STACK_PROTECTION
	bool
	default n

config INIT_STACKS
	bool
	default y

# Enable getting reboot-reason information.
config HWINFO
	bool
	default y

config CHIP_DEVICE_VENDOR_ID
	int
	default 65521

config CHIP_DEVICE_PRODUCT_ID
	int
	default 32768

# Trim parts of the Zephyr IPv6 stack Matter does not need.
config NET_IPV6_NBR_CACHE
	bool
	default n

config NET_IPV6_MLD
	bool
	default y

config NET_IF_MCAST_IPV6_ADDR_COUNT
	int
	default 14

# mbedTLS heap for the crypto/PASE path (portable SPAKE2+ over mbedTLS).
config MBEDTLS_ENABLE_HEAP
	bool
	default y

config MBEDTLS_HEAP_SIZE
	int
	default 15360

# Faster NVS lookups for the settings backend.
config NVS_LOOKUP_CACHE
	bool
	default y

# Extended commissionable-node discovery.
config CHIP_EXTENDED_DISCOVERY
	bool
	default y

# This is a WiFi build — do NOT default the 802.15.4 L2 on (the generic file does).
config NET_L2_OPENTHREAD
	bool
	default n

# Disable unused shell modules (RAM). The Matter/CHIP shell itself is off in prj.conf.
config SENSOR_SHELL
	bool
	default n

config DEVICE_SHELL
	bool
	default n

config DATE_SHELL
	bool
	default n

config DEVMEM_SHELL
	bool
	default n

config FLASH_SHELL
	bool
	default n

endif # CHIP
